@model app_dev_assignment.Models.ImageUploadViewModel

@{
    ViewData["Title"] = "Image Analyzer";
}

<div class="space-y-6">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-block">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
                <p class="text-xs uppercase tracking-[0.3em] text-slate-400">Upload</p>
                <h2 class="mt-2 text-2xl font-semibold text-slate-900">Upload your image</h2>
                <p class="mt-2 text-sm leading-6 text-slate-600">Choose a JPEG, PNG, or WebP image up to 10 MB. Mystik Vision extracts observable evidence, then separates description from interpretation and uncertainty.</p>
            </div>
            <span class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">Evidence analysis</span>
        </div>

        <form asp-action="Index" method="post" enctype="multipart/form-data" class="mt-6 space-y-5">
            <div class="space-y-2">
                <label asp-for="ImageFile" class="block text-sm font-medium text-slate-700">Image file</label>
                <div class="rounded-3xl border border-slate-200 bg-slate-50 p-4">
                    <input asp-for="ImageFile" type="file" accept="image/jpeg,image/png,image/webp" class="w-full text-sm text-slate-700 file:mr-4 file:rounded-full file:border-0 file:bg-white file:px-4 file:py-2 file:text-sm file:font-semibold file:text-slate-700 hover:file:bg-slate-100" />
                </div>
                <span asp-validation-for="ImageFile" class="text-sm text-red-600"></span>
            </div>

            <button type="submit" class="inline-flex items-center justify-center rounded-3xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">Analyze image</button>
        </form>
    </section>

    @if (Model.ImageUrl is not null)
    {
        <section class="grid gap-6 xl:grid-cols-[1.3fr_0.9fr]">
            <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-block">
                <div class="mb-6 flex items-center justify-between gap-4">
                    <div>
                        <p class="text-xs uppercase tracking-[0.3em] text-slate-400">Preview</p>
                        <h3 class="mt-2 text-lg font-semibold text-slate-900">Uploaded image</h3>
                    </div>
                    <span class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">@Model.CacheStatus</span>
                </div>
                <div class="overflow-hidden rounded-3xl border border-slate-200 bg-slate-50">
                    <img src="@Model.ImageUrl" alt="Uploaded image for visual analysis" class="h-full w-full object-cover" />
                </div>
            </article>

            <div class="space-y-6">
                <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-block">
                    <div class="mb-4">
                        <p class="text-xs uppercase tracking-[0.3em] text-slate-400">Visual report</p>
                        <h3 class="mt-2 text-lg font-semibold text-slate-900">Evidence-grounded analysis</h3>
                    </div>
                    @if (Model.Analysis is not null)
                    {
                        <p class="text-sm leading-7 text-slate-700">@Model.Analysis.Overview</p>
                        @if (Model.Analysis.Objects.Any())
                        {
                            <div class="mt-6"><h4 class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Observed objects</h4><div class="mt-3 space-y-2">@foreach (var item in Model.Analysis.Objects) { <div class="flex items-center justify-between rounded-2xl border border-slate-200 px-3 py-2 text-sm"><span class="font-medium text-slate-800">@item.Name</span><span class="text-slate-500">@item.Confidence.ToString("P0")</span></div> }</div></div>
                        }
                        <div class="mt-6 grid gap-4 sm:grid-cols-2">
                            <div><h4 class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Environment</h4><p class="mt-2 text-sm leading-6 text-slate-700">@Model.Analysis.Scene.Environment</p></div>
                            <div><h4 class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Colour</h4><p class="mt-2 text-sm leading-6 text-slate-700">@(Model.Analysis.Colors.DominantForegroundColor ?? "Not available") foreground / @(Model.Analysis.Colors.DominantBackgroundColor ?? "not available") background</p></div>
                        </div>
                        @foreach (var interpretation in Model.Analysis.Interpretations) { <div class="mt-6 border-l-2 border-slate-300 pl-4"><h4 class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Interpretation</h4><p class="mt-2 text-sm leading-6 text-slate-700">@interpretation.Statement</p></div> }
                        @foreach (var uncertainty in Model.Analysis.Uncertainties) { <div class="mt-6 border-l-2 border-amber-300 pl-4"><h4 class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Uncertainty</h4><p class="mt-2 text-sm leading-6 text-slate-700">@uncertainty.Statement</p></div> }
                        <details class="mt-6 rounded-2xl border border-slate-200 p-4"><summary class="cursor-pointer text-sm font-semibold text-slate-700">Technical evidence</summary><dl class="mt-4 grid gap-2 text-xs text-slate-600"><div class="flex justify-between"><dt>Engine</dt><dd>@Model.Analysis.Metadata.EngineVersion</dd></div><div class="flex justify-between"><dt>Provider</dt><dd>@Model.Analysis.Metadata.Provider</dd></div><div class="flex justify-between"><dt>API</dt><dd>@Model.Analysis.Metadata.ProviderApiVersion</dd></div><div class="flex justify-between"><dt>Fingerprint</dt><dd class="max-w-[12rem] truncate">@Model.Analysis.Metadata.ImageHash</dd></div></dl></details>
                    }
                    else
                    {
                        <p class="text-sm leading-7 text-slate-700">@Model.Description</p>
                    }
                </article>

                <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-block">
                    <div class="mb-4">
                        <p class="text-xs uppercase tracking-[0.3em] text-slate-400">Detected concepts</p>
                        <h3 class="mt-2 text-lg font-semibold text-slate-900">Tags</h3>
                    </div>
                    <div class="flex flex-wrap gap-3">
                        @if (Model.Tags?.Any() == true)
                        {
                            foreach (var tag in Model.Tags)
                            {
                                <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-sm text-slate-700">@tag</span>
                            }
                        }
                        else
                        {
                            <span class="text-sm text-slate-500">No tags were detected.</span>
                        }
                    </div>
                </article>
            </div>
        </section>
    }
</div>